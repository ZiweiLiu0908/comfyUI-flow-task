DATABASE_URL=postgresql+asyncpg://postgres:postgres:localhost:5432/task_manager
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your-strong-password-here   # 必须设置，不能留空
AUTH_SECRET=your-random-secret-at-least-32-chars  # 必须设置，至少32字符
AUTH_TOKEN_EXPIRE_MINUTES=1440
UPLOAD_API_BASE_URL=http://api.test-hot-product.echooo.link
CORS_ORIGINS=http://127.0.0.1:5173
LOG_DIR=logs
COMFYUI_API_BASE_URL=http://34.59.208.230:8190
VIDEO_IMAGE_UPLOAD_API_URL=http://api.hot-products.echooo.link/api/v1/video/upload-image
GCS_PROJECT_ID=ai-agent-461123
GCS_BUCKET_NAME=audio_test_112
# GCS 上视频对象的目录前缀
GCS_VIDEO_PREFIX=video-sources
# gcs（默认）→ 上传 GCS bucket；cdn → 走 UPLOAD_API_BASE_URL
VIDEO_UPLOAD_BACKEND=gcs

# Google Gemini 官方 API（设置后优先使用，替代 EvoLink）
# Google AI Studio API Key（https://aistudio.google.com/app/apikey）
GOOGLE_API_KEY=

# 「补充模板」外包给 StyleDNA / vendor（exclusive + auto 模式）
# 留空则使用内部 candidate_service 走 Apify 搜索（fallback）
# 注意：以下值不要在行尾加注释，python-dotenv 会把 `# xxx` 当成值的一部分
VENDOR_SUPPLEMENT_API_URL=https://ws.alvinsclub.ai/supplement-vendor
# Bearer token，由 vendor 提供
VENDOR_SUPPLEMENT_API_KEY=
# 我们公网域名，构造 callback_url
VENDOR_CALLBACK_PUBLIC_BASE=http://echoootx.top

# Evolink AI（Google quota 耗尽后的 fallback vendor；留空即关闭 fallback）
# 文本走 direct.evolink.ai/v1/chat/completions（OpenAI 兼容）；
# 图像生成 / 任务查询走 api.evolink.ai。
EVOLINK_API_KEY=
# 以下默认值通常不需要改：
# EVOLINK_TEXT_BASE_URL=https://direct.evolink.ai
# EVOLINK_API_BASE_URL=https://api.evolink.ai
# EVOLINK_TEXT_MODEL=gemini-3.1-pro-preview
# EVOLINK_IMAGE_MODEL=gemini-3-pro-image-preview
# EVOLINK_IMAGE_POLL_INTERVAL_SEC=5
# EVOLINK_IMAGE_POLL_TIMEOUT_SEC=300

# TikTok 第三方 API 配置
TIKWM_API_KEY=                    # 可选，tikwm.com API key
RAPIDAPI_KEY=your_rapidapi_key    # RapidAPI key，用于 tiktok-api23 fallback
TIKTOK_SEARCH_USE_RAPIDAPI=false
APIFY_TOKEN=

# Open API 配置（视频发布服务）
OPEN_API_BASE_URL=http://192.168.199.181:8080
OPEN_API_CLIENT_ID=default_client
OPEN_API_CLIENT_SECRET=xxxxx
OPEN_API_CHANNEL_USAGE_TYPES=
# OPEN_API_CALLBACK_URL=http://your-domain.com/api/v1/open-api/callback/publication  # 可选，用于接收发布回调
PROMOTION_CODE_POOL_SIZE=10000

# KOL 长链 / 短链（Account 创建后异步生成 KOL 可分享链接）
KOL_LONG_LINK_BASE_URL=https://www.alvinclub.ai/en-us/m/vibe
SHORT_LINK_ENCODE_API=https://api.alvinclub.com/user-service/slk/encode/link
SHORT_LINK_DISPLAY_HOST=https://alvc.me

# BigQuery（用于发布 24 小时后的点击统计）
BIGQUERY_PROJECT_ID=my-project-8584-jetonai
# 24h 点击快照调度器轮询频率（秒）
PUBLICATION_CLICK_METRICS_POLL_INTERVAL_SEC=600

# 商品以图搜图（AI 单品图生成后，用单品描述 + 单品图搜索真实商品）
PRODUCT_SEARCH_API_URL=https://api.alvinclub.com/ai-service/api/v1/style-outfits/search/image-internal
PRODUCT_SEARCH_INTERNAL_SCORE_THRESHOLD=0.9
PRODUCT_SEARCH_TOP_N=3
PRODUCT_SEARCH_TIMEOUT_SECONDS=45

# 外部发布 API（独立维护的第三方频道发布服务）
EXT_PUB_API_BASE_URL=http://34.21.25.209:8000
# X-API-Key 认证密钥
EXT_PUB_API_KEY=

ACCOUNT_CHANNEL_OWNER_ID=
ACCOUNT_CHANNEL_API_KEY=


# Lark 机器人通知（每天 UTC 02:00 推送发布日报，留空则不发送）
# LARK_WEBHOOK_URL=https://open.larksuite.com/open-apis/bot/v2/hook/xxxx
